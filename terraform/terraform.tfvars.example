# GCP
gcp_project_id = ""
gcp_region     = "europe-west3"

# Sync schedule (cron, UTC)
sync_schedule = "0 1 * * *"

# Internal owner id: all data and the bot state are stored under it.
# `setup.py config` creates it (a UUID). Never change it on a running install.
owner_user_id = ""

# Optional: language of the bot's menus and commands (ru, en). Empty = the Telegram app language.
# Free-form questions are always answered in the language they were asked in.
# bot_language = "ru"

# Optional: another Claude model for a bot task (chat, analysis, weekly, alerts, morning).
# Defaults: chat/analysis = claude-sonnet-5-5, the rest = claude-haiku-5-5.
# bot_models = { chat = "claude-opus-5-5" }

# Secret values (Telegram, Anthropic, data-source keys) are not kept here:
# they live only in Secret Manager (scripts/setup.py secrets).
